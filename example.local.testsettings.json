{
  "Api": {
    "sample": {
      "BaseUrl": "http://localhost:5080/",
      "HealthPath": "/health",
      "Auth": "None",
      "RequestTimeout": "00:00:30"
    },
    "sample-keyed": {
      "BaseUrl": "http://localhost:5080/",
      "HealthPath": "/health",
      "Auth": "ApiKey",
      "ApiKeyHeaderName": "x-api-key",
      "ApiKey": "replace-me"
    },
    "sample-windows": {
      "BaseUrl": "http://localhost:5080/",
      "HealthPath": "/health",
      "Auth": "Negotiate"
    }
  },
  "Sql": {
    "main": {
      "Server": "localhost,1433",
      "Database": "SampleDb",
      "IntegratedSecurity": true,
      "TrustServerCertificate": true,
      "CommandTimeout": "00:00:30"
    },
    "container": {
      "ConnectionString": "Server=localhost,51433;Database=SampleDb;User Id=sa;Password=replace-me;TrustServerCertificate=True"
    }
  },
  "Web": {
    "SensitiveHeaders": [ "x-tenant-secret" ]
  }
}
