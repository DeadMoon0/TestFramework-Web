<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TestFramework.Web</Title>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Web;Rest;Api;Http;Sql;SqlServer;Stub;Mock;WireMock</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Test web applications from inside a TestFramework timeline: REST APIs, the SQL Server databases behind them, and the dependencies they call. Provides identifier-driven configuration, variable-backed HTTP requests and SQL statements, row artifacts with automatic teardown, liveness probes, stub declarations with request verification, and request authentication including Windows Negotiate.</Description>
		<Version>0.6.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Web</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Web.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0 and TestFramework.Config 0.4.0. Stub.Calls(identifier) narrows with WithMethod(...) and WithPath(...) instead of optional arguments, and Stub.Called refuses a null method instead of waiting for GET. A stub response delay or templating is set with Respond(StubResponse.Json(...) with { Delay = ..., UseTemplating = true }). Results, stub mappings and SQL steps are built by Web only; SqlCredentials comes from Integrated or Login; SqlScriptExecutionResult uses init properties. Optional parameters elsewhere became overloads. Web:SensitiveHeaders and RedactHeaders(...) now add up instead of the last registration winning. BREAKING - a custom SQL executor is registered as an ISqlExecutorFactory with UseSqlExecutor(factory), which is handed the run; an ISqlExecutor registered as a service is refused. A SQL statement without a CommandTimeout now runs under the step timeout instead of the driver's hidden 30 s, and a sub-second timeout rounds up instead of meaning "forever". BREAKING - a row whose key the database assigns is created by leaving that key out, Row&lt;T&gt;(identifier), and KeyTo(x =&gt; x.Id, "id") hands the key on; giving a value for it, which leaked a row every run, is now refused at setup, as is seed data whose key disagrees with its reference. ConfigExtension is renamed WebConfigExtension, so Web and Azure can be imported together.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Web.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.66" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="TestFramework.Config" Version="0.4.0" />
		<PackageReference Include="TestFramework.Core" Version="0.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Modules\TestFramework-Common\Assets\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- Direct references override the System.Security.Cryptography.Pkcs that Microsoft.Data.SqlClient pulls
	     in transitively (8.0.1 / 9.0.4: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); no SqlClient release ships a
	     patched one yet. One per framework, each the patched release of the line that framework's runtime ships. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

</Project>
