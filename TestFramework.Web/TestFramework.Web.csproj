<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TestFramework.Web</Title>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Web;Rest;Api;Http;Sql;SqlServer;Stub;Mock;WireMock</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Test web applications from inside a TestFramework timeline: REST APIs, the SQL Server databases behind them, and the dependencies they call. Provides identifier-driven configuration, variable-backed HTTP requests and SQL statements, row artifacts with automatic teardown, liveness probes, stub declarations with request verification, and request authentication including Windows Negotiate.</Description>
		<Version>0.6.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Web</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Web.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0 and TestFramework.Config 0.4.0. Stub.Calls(identifier) narrows with WithMethod(...) and WithPath(...) instead of optional arguments, and Stub.Called refuses a null method instead of waiting for GET. A stub response delay or templating is set with Respond(StubResponse.Json(...) with { Delay = ..., UseTemplating = true }). Results, stub mappings and SQL steps are built by Web only; SqlCredentials comes from Integrated or Login; SqlScriptExecutionResult uses init properties. Optional parameters elsewhere became overloads. Web:SensitiveHeaders and RedactHeaders(...) now add up instead of the last registration winning. BREAKING - a custom SQL executor is registered as an ISqlExecutorFactory with UseSqlExecutor(factory), which is handed the run; an ISqlExecutor registered as a service is refused.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Web.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.66" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="TestFramework.Config" Version="0.4.0" />
		<PackageReference Include="TestFramework.Core" Version="0.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Modules\TestFramework-Common\Assets\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
